# Copy to .env (git-ignored).
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list; leave empty to allow none (the Android app does not need CORS).
CORS_ORIGINS=

# PostgreSQL. Leave empty in development to use the embedded PGlite database (npm run dev stores it in ./.data).
# Required in production, e.g. postgres://USER:PASSWORD@/tripwise?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=
# HS256 key for access tokens, at least 32 characters. Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Server-side only. Never ship this key in the Android app. (Used from the AI phase on.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
