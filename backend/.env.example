# Copy to .env (git-ignored).
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list; leave empty to allow none (the Android app does not need CORS).
CORS_ORIGINS=
# Server-side only. Never ship this key in the Android app. (Used from the AI phase on.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
